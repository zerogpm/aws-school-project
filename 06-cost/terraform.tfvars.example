# Copy to terraform.tfvars and adjust. *.tfvars is gitignored.
aws_region   = "ca-central-1"
project_name = "school"

# Uncomment to let a locally served front end complete a hosted UI sign-in.
# Adds http://localhost:5173/staff as a callback URL on the app client.
# dev_origins = ["http://localhost:5173"]

# Custom domain. Leave both unset to keep the *.cloudfront.net name and create
# no Route53 or ACM resources at all.
#
# From this stage on they do more than name the site: SES verifies the SENDER by
# writing DKIM records into the hosted zone, so with no domain there is no
# identity, and modules/booking creates no email consumer at all. The rest of
# the stack still applies - it is the stack minus the episode.
#
# A subdomain of a zone you already own costs nothing extra - a new hosted zone
# is $0.50/month. The certificate is free, and lives in us-east-1 because
# CloudFront accepts one from nowhere else.
# domain_name      = "xxxx.xxxx.xxxx"
# hosted_zone_name = "xxxxx.xxxxx"

# One office-staff account, created after the pool exists so the admin page is
# reachable without making a user in the console. Leave both unset for a real
# deployment. The password is never written to state; without it Cognito emails
# a temporary one and forces a change at first sign-in.
# demo_staff_email    = "you@example.com"
# demo_staff_password = "Str0ng!DemoPassw0rd"

# Addresses to verify as SES RECIPIENTS.
#
# The part of the sandbox that surprises people: verifying the domain above
# authorises the sender and says nothing about who may receive. Until this region
# has production access, SES accepts a message to an unverified address and
# delivers it nowhere - silently.
#
# Each address here gets a link from AWS that a human clicks once. Defaults to
# the demo inbox; empty it once production access lands.
# verified_recipients = ["someone@example.com"]

# Send Cognito's staff email through SES too.
#
# Leave false until this region has SES production access. Cognito's own sender
# is capped at 50 a day but reaches anyone; SES in the sandbox is uncapped but
# reaches only verified addresses, which sixty staff accounts are not. Turning
# this on early takes staff invites from limited to impossible, and fails this
# stage's apply at the demo-staff script.
# cognito_email_via_ses = true

# Where the guardrails send. Unset creates NEITHER of them - no budgets, no
# health check, no alarm, no topic. The rest of the stack still applies.
#
# One address, and the maintainer's. A budget threshold or a dead API is not
# something the other fifty-nine staff can act on.
#
# The budgets mail it directly. The health alarm goes through SNS, so AWS sends
# a subscription confirmation that has to be clicked once - until then the apply
# has succeeded and the alarm still cannot reach anybody.
# alert_email = "you@example.com"

# The monthly budget, in dollars. Ten is the target, not the twenty-dollar cap:
# budgeting the cap puts the first warning at ten and the last one after the
# month is lost. At ten, the first mail arrives at five.
# monthly_budget_usd = 10

# The daily budget, in dollars. This is the runaway tripwire - a loop that would
# take weeks to breach the monthly budget breaches this one overnight.
#
# The stack burns roughly five to seven cents a day idle. Drop this to 0.02 for
# a recording pass and it trips every morning; put it back afterwards.
# daily_budget_usd = 1

# Which Route53 checker regions probe the API. Three is the API's own minimum,
# and three is the point: unpinned, Route53 probes from everywhere it has and
# the endpoint takes roughly 1.3 million requests a month instead of 260
# thousand. Raising this raises the bill and buys very little.
# health_check_regions = ["us-east-1", "us-west-1", "eu-west-1"]
